+static bool Is_Read_Only_Crypto_Mount(const char* path) {
+	struct statvfs mount_info {};
+	return statvfs(path, &mount_info) == 0 && (mount_info.f_flag & ST_RDONLY);
+}
+
+static bool Copy_P3s_Crypto_Properties() {
+	static bool properties_ready = false;
+	if (properties_ready)
+		return true;
+
+	std::string release = TWFunc::System_Property_Get("ro.system.build.version.release");
+	if (release.empty())
+		release = TWFunc::System_Property_Get("ro.build.version.release");
+	const std::string patch = TWFunc::System_Property_Get("ro.build.version.security_patch");
+	const std::string vendor_patch = TWFunc::Partition_Property_Get("ro.vendor.build.security_patch", PartitionManager, "/vendor", "build.prop");
+	if (release.empty() || patch.empty() || vendor_patch.empty() || patch == "2099-12-31" || vendor_patch == "2099-12-31") {
+		LOGERR("Unable to read installed Android and vendor security versions for p3s Keymaster\n");
+		return false;
+	}
+	if (TWFunc::Property_Override("ro.build.version.release", release) != 0 ||
+	    TWFunc::Property_Override("ro.build.version.security_patch", patch) != 0 ||
+	    TWFunc::Property_Override("ro.vendor.build.security_patch", vendor_patch) != 0 ||
+	    ::android::base::GetProperty("ro.build.version.release", "") != release ||
+	    ::android::base::GetProperty("ro.build.version.security_patch", "") != patch ||
+	    ::android::base::GetProperty("ro.vendor.build.security_patch", "") != vendor_patch) {
+		LOGERR("Unable to apply installed security versions for p3s Keymaster\n");
+		return false;
+	}
+	properties_ready = true;
+	return true;
+}
+
+static bool Start_P3s_Crypto_Services(TWPartition* vendor) {
+	using namespace std::chrono_literals;
+	using ::android::base::SetProperty;
+	using ::android::base::WaitForProperty;
+	using ::android::hardware::keymaster::V4_0::IKeymasterDevice;
+	constexpr auto keystore_service = "android.system.keystore2.IKeystoreService/default";
+
+	if (vendor)
+		vendor->Change_Mount_Read_Only(true);
+	if (!vendor || !vendor->Mount(false) || !Is_Read_Only_Crypto_Mount("/vendor") || !Copy_P3s_Crypto_Properties()) {
+		LOGERR("Unable to prepare the mounted vendor for p3s storage decryption\n");
+		return false;
+	}
+	if (!SetProperty("ctl.start", "p3s-tzdaemon") || !WaitForProperty("vendor.tzdaemon", "Ready", 5s)) {
+		LOGERR("Samsung TEEGRIS did not become ready in recovery\n");
+		return false;
+	}
+	SetProperty("vendor.TEEGRIS.loaded", "true");
+	SetProperty("ctl.start", "p3s-tzts");
+	SetProperty("ctl.start", "p3s-gatekeeper");
+	if (!WaitForProperty("hwservicemanager.ready", "true", 2s) || !SetProperty("ctl.start", "p3s-keymaster")) {
+		LOGERR("Unable to start Samsung Keymaster 4.0\n");
+		return false;
+	}
+	const auto keymaster_deadline = std::chrono::steady_clock::now() + 5s;
+	while (!IKeymasterDevice::tryGetService()) {
+		if (std::chrono::steady_clock::now() >= keymaster_deadline) {
+			LOGERR("Samsung Keymaster 4.0 did not register in recovery\n");
+			return false;
+		}
+		usleep(100000);
+	}
+	if (!SetProperty("ctl.start", "keystore2")) {
+		LOGERR("Unable to start recovery Keystore2\n");
+		return false;
+	}
+	const auto keystore_deadline = std::chrono::steady_clock::now() + 5s;
+	do {
+		if (AIBinder* keystore = AServiceManager_checkService(keystore_service)) {
+			AIBinder_decStrong(keystore);
+			return true;
+		}
+		usleep(100000);
+	} while (std::chrono::steady_clock::now() < keystore_deadline);
+	LOGERR("Recovery Keystore2 did not register\n");
+	return false;
+}
