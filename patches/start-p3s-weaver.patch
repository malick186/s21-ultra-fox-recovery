+bool SameFile(const struct stat& first, const struct stat& second) {
+    return first.st_dev == second.st_dev && first.st_ino == second.st_ino;
+}
+
+bool IsHermesRamBind(const char* source, const char* target) {
+    struct stat source_stat {}, target_stat {};
+    struct statfs target_fs {};
+    return stat(source, &source_stat) == 0 && stat(target, &target_stat) == 0 &&
+           SameFile(source_stat, target_stat) && statfs(target, &target_fs) == 0 &&
+           target_fs.f_type == TMPFS_MAGIC;
+}
+
+bool CopyWeaverStateFile(int source_dir, int snapshot_dir, const char* name, dev_t source_device) {
+    struct stat entry {}, source {}, after {};
+    if (fstatat(source_dir, name, &entry, AT_SYMLINK_NOFOLLOW) != 0) {
+        std::perror("Unable to inspect a Samsung Weaver state entry");
+        return false;
+    }
+    if (!S_ISREG(entry.st_mode) || entry.st_dev != source_device || entry.st_nlink != 1) {
+        std::printf("Samsung Weaver state contains an unsupported entry\n");
+        return false;
+    }
+    ::android::base::unique_fd input(openat(source_dir, name,
+                                           O_RDONLY | O_NOFOLLOW | O_NOATIME | O_NONBLOCK | O_CLOEXEC));
+    if (input == -1 || fstat(input.get(), &source) != 0) {
+        std::perror("Unable to open a Samsung Weaver state file read-only");
+        return false;
+    }
+    if (!SameFile(entry, source) || !S_ISREG(source.st_mode) ||
+        source.st_nlink != 1 || source.st_size < 0) {
+        std::printf("Samsung Weaver state changed before a file could be read\n");
+        return false;
+    }
+    ::android::base::unique_fd output(openat(snapshot_dir, name,
+                                            O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600));
+    if (output == -1) {
+        std::perror("Unable to create a Samsung Weaver state file in RAM");
+        return false;
+    }
+
+    KeyBuffer buffer(4096);
+    for (off_t remaining = source.st_size; remaining > 0;) {
+        const auto count = static_cast<size_t>(std::min<off_t>(remaining, buffer.size()));
+        if (!::android::base::ReadFully(input.get(), buffer.data(), count) ||
+            !::android::base::WriteFully(output.get(), buffer.data(), count)) {
+            std::printf("Unable to read or copy a Samsung Weaver state file\n");
+            return false;
+        }
+        remaining -= count;
+    }
+    const timespec timestamps[] = {source.st_atim, source.st_mtim};
+    if (fstat(input.get(), &after) != 0 || after.st_size != source.st_size ||
+        after.st_ctim.tv_sec != source.st_ctim.tv_sec || after.st_ctim.tv_nsec != source.st_ctim.tv_nsec) {
+        std::printf("Samsung Weaver state changed during the RAM copy\n");
+        return false;
+    }
+    if (fchown(output.get(), source.st_uid, source.st_gid) != 0 ||
+        fchmod(output.get(), source.st_mode & 0777) != 0 || futimens(output.get(), timestamps) != 0) {
+        std::perror("Unable to set Samsung Weaver file metadata in RAM");
+        return false;
+    }
+    return true;
+}
+
+bool CopyWeaverState(DIR* entries, const struct stat& state) {
+    ::android::base::unique_fd snapshot(open(kHermesSnapshot, O_RDONLY | O_DIRECTORY | O_NOFOLLOW |
+                                                                       O_CLOEXEC));
+    if (snapshot == -1 || fchown(snapshot.get(), state.st_uid, state.st_gid) != 0 ||
+        fchmod(snapshot.get(), state.st_mode & 0777) != 0) {
+        std::perror("Unable to prepare the Samsung Weaver snapshot directory");
+        return false;
+    }
+
+    std::printf("Reading existing Samsung Weaver state into RAM\n");
+    bool copied = false;
+    while (true) {
+        errno = 0;
+        const dirent* entry = readdir(entries);
+        if (!entry) {
+            if (errno != 0) {
+                std::perror("Unable to enumerate existing Samsung Weaver state");
+                return false;
+            }
+            if (!copied) std::printf("Samsung Weaver state directory contains no files\n");
+            return copied;
+        }
+        if (std::strcmp(entry->d_name, ".") == 0 || std::strcmp(entry->d_name, "..") == 0) continue;
+        if (!CopyWeaverStateFile(dirfd(entries), snapshot.get(), entry->d_name, state.st_dev)) {
+            return false;
+        }
+        copied = true;
+    }
+}
+
+bool PrepareP3sWeaver() {
+    struct stat state {};
+    struct stat firmware {};
+    struct stat secure_element {};
+    struct stat recovery_namespace {};
+    struct stat init_namespace {};
+    if (stat("/proc/self/ns/mnt", &recovery_namespace) != 0 ||
+        stat("/proc/1/ns/mnt", &init_namespace) != 0 ||
+        recovery_namespace.st_ino != init_namespace.st_ino) {
+        std::printf("Samsung Weaver requires the recovery init mount namespace\n");
+        return false;
+    }
+    if (lstat(kHermesFirmware, &firmware) != 0 || !S_ISDIR(firmware.st_mode) ||
+        stat("/dev/k250a", &secure_element) != 0 || !S_ISCHR(secure_element.st_mode)) {
+        std::printf("Samsung Weaver requires the vendor firmware directory and K250A device\n");
+        return false;
+    }
+    // Pin the source before any mount changes and read all entries relative to it.
+    ::android::base::unique_fd source(open(kHermesState, O_RDONLY | O_DIRECTORY | O_NOFOLLOW |
+                                                                   O_NOATIME | O_CLOEXEC));
+    if (source == -1 || fstat(source.get(), &state) != 0) {
+        std::perror("Unable to open the existing Samsung Weaver state directory read-only");
+        return false;
+    }
+    std::unique_ptr<DIR, decltype(&closedir)> entries(fdopendir(source.get()), closedir);
+    if (!entries) {
+        std::perror("Unable to prepare the existing Samsung Weaver state directory for reading");
+        return false;
+    }
+    static_cast<void>(source.release());
+    std::printf("Opened existing Samsung Weaver state read-only\n");
+    if (mkdir(kHermesRam, 0700) != 0) {
+        std::perror("Unable to create the temporary Samsung Weaver directory");
+        return false;
+    }
+    if (mount("tmpfs", kHermesRam, "tmpfs", kHermesMountFlags, "mode=0700,size=4m") != 0) {
+        std::perror("Unable to prepare temporary Samsung Weaver storage");
+        rmdir(kHermesRam);
+        return false;
+    }
+    auto ram_cleanup = ::android::base::make_scope_guard([] {
+        umount2(kHermesRam, MNT_DETACH);
+        rmdir(kHermesRam);
+    });
+    if (mkdir(kHermesSnapshot, 0700) != 0) {
+        std::perror("Unable to create the Samsung Weaver snapshot directory");
+        return false;
+    }
+    if (!CopyWeaverState(entries.get(), state)) return false;
+    std::printf("Copied existing Samsung Weaver state into RAM\n");
+    if (mkdir(kEmptyFirmware, 0755) != 0 || mount(kEmptyFirmware, kHermesFirmware, nullptr, MS_BIND, nullptr) != 0) {
+        std::perror("Unable to prepare the Samsung Weaver firmware mask");
+        return false;
+    }
+    auto firmware_cleanup = ::android::base::make_scope_guard([] {
+        umount2(kHermesFirmware, MNT_DETACH);
+    });
+    if (mount(nullptr, kHermesFirmware, nullptr,
+              MS_REMOUNT | MS_BIND | MS_RDONLY | kHermesMountFlags, nullptr) != 0) {
+        std::perror("Unable to mask Samsung Weaver firmware update files");
+        return false;
+    }
+    // Hermes opens the original path directly. Make that path resolve to the RAM copy.
+    struct stat target {};
+    if (lstat(kHermesState, &target) != 0 || !SameFile(state, target)) {
+        std::printf("Samsung Weaver state directory changed before the protected bind\n");
+        return false;
+    }
+    if (mount(kHermesSnapshot, kHermesState, nullptr, MS_BIND, nullptr) != 0) {
+        std::perror("Unable to bind the Samsung Weaver RAM snapshot");
+        return false;
+    }
+    auto state_cleanup = ::android::base::make_scope_guard([] {
+        umount2(kHermesState, MNT_DETACH);
+    });
+    struct statvfs firmware_mount {};
+    if (!IsHermesRamBind(kHermesSnapshot, kHermesState) ||
+        !IsHermesRamBind(kEmptyFirmware, kHermesFirmware) ||
+        statvfs(kHermesFirmware, &firmware_mount) != 0 || !(firmware_mount.f_flag & ST_RDONLY)) {
+        std::printf("Unable to verify the Samsung Weaver RAM snapshot and read-only firmware mask\n");
+        return false;
+    }
+    state_cleanup.Disable();
+    firmware_cleanup.Disable();
+    ram_cleanup.Disable();
+    std::printf("Samsung Weaver RAM snapshot and read-only firmware mask verified\n");
+    return true;
+}
