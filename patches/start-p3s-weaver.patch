+Weaver::Weaver() : GottenConfig(false) {
+    using namespace std::chrono_literals;
+    if (IWeaver::tryGetService()) {
+        std::printf("Samsung Weaver was already running before protected startup\n");
+        return;
+    }
+    if (!PrepareP3sWeaver()) return;
+    paths_prepared_ = true;
+    if (!::android::base::SetProperty("ctl.start", "p3s-hermesd")) {
+        std::printf("Unable to start the Samsung Weaver service\n");
+        return;
+    }
+    const auto deadline = std::chrono::steady_clock::now() + 10s;
+    do {
+        mDevice = IWeaver::tryGetService();
+        if (mDevice) {
+            std::printf("Samsung Weaver 1.0 registered in recovery\n");
+            return;
+        }
+        usleep(100000);
+    } while (std::chrono::steady_clock::now() < deadline);
+    std::printf("Samsung Weaver 1.0 did not register in recovery\n");
+}
+
+Weaver::~Weaver() {
+    using namespace std::chrono_literals;
+    if (!paths_prepared_) return;
+    mDevice.clear();
+    if (!::android::base::SetProperty("ctl.stop", "p3s-hermesd") ||
+        !::android::base::WaitForProperty("init.svc.p3s-hermesd", "stopped", 3s)) {
+        std::printf("Unable to confirm Samsung Weaver stopped; recovery RAM mounts retained\n");
+        return;
+    }
+    if (IsHermesRamBind(kHermesSnapshot, kHermesState)) umount2(kHermesState, MNT_DETACH);
+    if (IsHermesRamBind(kEmptyFirmware, kHermesFirmware)) umount2(kHermesFirmware, MNT_DETACH);
+    umount2(kHermesRam, MNT_DETACH);
+    rmdir(kHermesRam);
+    std::printf("Samsung Weaver stopped after the credential check\n");
 }
 
