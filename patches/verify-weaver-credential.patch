+static bool ParseWeaverSlot(const std::string& record, uint32_t* slot) {
+	// Android stores version 1 followed by a signed, big-endian 32-bit slot.
+	constexpr size_t record_size = 1 + sizeof(uint32_t);
+	if (record.size() != record_size || record[0] != 1) return false;
+	const auto* bytes = reinterpret_cast<const unsigned char*>(record.data());
+	if (bytes[1] & 0x80) return false;
+
+	uint32_t value = 0;
+	for (size_t offset = 1; offset < record_size; ++offset) {
+		value = (value << 8) | bytes[offset];
+	}
+	*slot = value;
+	return true;
+}
+
+static bool ReadWeaverSlot(const std::string& spblob_path, const std::string& handle_str,
+			   uint32_t* slot) {
+	printf("Reading Android Weaver slot metadata\n");
+	std::string record;
+	if (!android::base::ReadFileToString(spblob_path + handle_str + ".weaver", &record)) {
+		printf("Unable to read Android Weaver slot metadata\n");
+		return false;
+	}
+	if (!ParseWeaverSlot(record, slot)) {
+		printf("Invalid Android Weaver slot metadata\n");
+		return false;
+	}
+	printf("Android Weaver slot metadata decoded\n");
 	return true;
 }
 
