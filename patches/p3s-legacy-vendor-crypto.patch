diff --git a/recovery/root/system/etc/init/p3s-recovery-crypto.rc b/recovery/root/system/etc/init/p3s-recovery-crypto.rc
new file mode 100644
--- /dev/null
+++ b/recovery/root/system/etc/init/p3s-recovery-crypto.rc
@@ -0,0 +1,35 @@
+# The partitions stay under recovery's control. Start only the stock TEE and crypto HALs.
+on post-fs
+    install_keyring
+    mkdir /dev/socket/iwt 0770 system system
+    mkdir /dev/socket/iwt/ca 0770 system system
+
+service p3s-tzdaemon /vendor/bin/tzdaemon
+    user system
+    group system readproc
+    disabled
+    seclabel u:r:recovery:s0
+    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
+
+service p3s-tzts /vendor/bin/tzts_daemon
+    user system
+    group system
+    disabled
+    seclabel u:r:recovery:s0
+    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
+
+service p3s-keymaster /vendor/bin/hw/android.hardware.keymaster@4.0-service
+    user system
+    group system drmrpc
+    interface android.hardware.keymaster@4.0::IKeymasterDevice default
+    disabled
+    seclabel u:r:recovery:s0
+    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
+
+service p3s-gatekeeper /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
+    user system
+    group system 5678
+    interface android.hardware.gatekeeper@1.0::IGatekeeper default
+    disabled
+    seclabel u:r:recovery:s0
+    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
